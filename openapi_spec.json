{
  "openapi": "3.1.0",
  "info": {
    "title": "Protein Electrophoresis Engine API",
    "description": "Experimental API for synthetic task metrics. Generic thresholds are not clinically validated.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Health and demonstration metadata."
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Process-local operational counters in JSON format",
        "responses": {
          "200": {
            "description": "JSON counters (not Prometheus exposition text)."
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demo rule dossier including an in-memory HMAC-chain entry hash."
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic demonstration adapter; no diagnostic inference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration-only response."
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory HMAC-chain audit metadata",
        "responses": {
          "200": {
            "description": "Audit metadata and signature verification; no durable log."
          }
        }
      }
    }
  }
}
